# cp .env.example .env 후 수정 (.env 는 gitignore). run.sh 가 읽음, 이미 설정된 env·인자가 우선
MC_HOST=localhost
MC_PORT=25565
# 봇 이름 (offline) / microsoft 면 계정 식별용(이메일 권장)
NAME=Miya
# offline(오프라인 모드 서버) | microsoft(정품 서버, 첫 실행시 bot.log 에 로그인 코드)
MC_AUTH=offline
# 26.1.2 | auto (auto 는 미검증 버전 레시피 어긋날 수 있음)
MC_VERSION=26.1.2
# 서빙 주소. 원격이면 run.sh 가 로컬 서빙 안 띄움 (원격 서빙은 SERVE_HOST=0.0.0.0 로 실행)
API=http://127.0.0.1:8765
# 웹UI 포트
WEB=8090,8091
